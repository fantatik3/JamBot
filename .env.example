# ---- Obligatorio ----
# Token del bot: Portal de desarrolladores de Discord > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# ID de la aplicación: Portal de desarrolladores > tu aplicación > General Information
CLIENT_ID=

# ---- Recomendado ----
# ID de tu servidor. Con esto definido, los comandos se registran al instante en ese servidor.
# (Discord > Ajustes de usuario > Avanzado > Modo desarrollador, y luego clic derecho en el servidor > Copiar ID)
GUILD_ID=
# Canal donde se publican los mensajes de bienvenida (clic derecho en el canal > Copiar ID)
WELCOME_CHANNEL_ID=

# ---- Opcional ----
# Rol que se asigna automáticamente a cada miembro nuevo (clic derecho en el rol > Copiar ID)
AUTO_ROLE_ID=
# Rol autorizado para usar /phrases (muestra todas las frases de bienvenida en el canal actual)
PREVIEW_ROLE_ID=
# Nivel de detalle del log: debug | info | warn | error
LOG_LEVEL=info

# ---- Mata la jerga ----
# Canal donde vive el juego. Las rondas empiezan aquí automáticamente a horas aleatorias.
JERGA_CHANNEL_ID=
# Rondas automáticas al día (0 las desactiva)
JERGA_ROUNDS_PER_DAY=6
# Horas (hora local de esta máquina) en las que pueden empezar rondas; 0-24 es todo el día
JERGA_ACTIVE_HOURS=0-24
# Minutos para enviar explicaciones y, después, minutos para votar
JERGA_SUBMIT_MINUTES=120
JERGA_VOTE_MINUTES=60
# Publica una ronda en cuanto el bot inicia sesión (útil para probar)
JERGA_ROUND_ON_START=false
