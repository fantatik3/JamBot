# ---- Obligatorio ----
# Token del bot: Portal de desarrolladores de Discord > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# ID de la aplicación: Portal de desarrolladores > tu aplicación > General Information
CLIENT_ID=

# ---- Recomendado ----
# ID de tu servidor. Con esto definido, los comandos se registran al instante en ese servidor.
# (Discord > Ajustes de usuario > Avanzado > Modo desarrollador, y luego clic derecho en el servidor > Copiar ID)
GUILD_ID=
# Canal donde se publican los mensajes de bienvenida (clic derecho en el canal > Copiar ID)
WELCOME_CHANNEL_ID=

# ---- Opcional ----
# Rol que se asigna automáticamente a cada miembro nuevo (clic derecho en el rol > Copiar ID)
AUTO_ROLE_ID=
# Rol de pruebas: puede usar /phrases y los subcomandos "test" y "tutorial" de los juegos en cualquier canal
PREVIEW_ROLE_ID=
# Nivel de detalle del log: debug | info | warn | error
LOG_LEVEL=info
# Idioma de todo lo que dice el bot: es | en (los idiomas están en src/locales)
BOT_LANGUAGE=es

# ---- Juegos ----
# Canal por defecto para los juegos que no tengan el suyo (opcional)
GAMES_CHANNEL_ID=
# Canal de cada juego. Sus comandos solo funcionan ahí y las rondas automáticas se publican ahí.
# Un juego sin canal propio usa GAMES_CHANNEL_ID; sin ninguno de los dos, no tiene rondas automáticas.
JERGA_CHANNEL_ID=
TRIAJE_CHANNEL_ID=
NOMBRALO_CHANNEL_ID=
SCOPE_CHANNEL_ID=
BUGS_CHANNEL_ID=
TRIVIA_CHANNEL_ID=
SMELLS_CHANNEL_ID=
# Rondas automáticas al día (0 las desactiva)
GAMES_ROUNDS_PER_DAY=6
# Horas (hora local de esta máquina) en las que pueden empezar rondas; 0-24 es todo el día
GAMES_ACTIVE_HOURS=0-24
# Minutos para enviar explicaciones y, después, minutos para votar
GAMES_SUBMIT_MINUTES=120
GAMES_VOTE_MINUTES=60
# Rondas al arrancar el bot: false (ninguna), true (una, la siguiente de la rotación) o all (una de cada juego, para probar)
GAMES_ROUND_ON_START=false
# Minutos por fase de esas rondas de arranque; vacío = duraciones normales
GAMES_ROUND_ON_START_MINUTES=
