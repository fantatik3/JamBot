# ── Required ──────────────────────────────────────────────────────────────
# Bot token: Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal > your app > General Information
CLIENT_ID=

# ── Recommended ───────────────────────────────────────────────────────────
# Your server ID. With this set, slash commands register instantly on that server.
# (Discord > User Settings > Advanced > Developer Mode, then right-click server > Copy Server ID)
GUILD_ID=
# Channel where welcome messages are posted (right-click channel > Copy Channel ID)
WELCOME_CHANNEL_ID=

# ── Optional ──────────────────────────────────────────────────────────────
# Role automatically given to every new member (right-click role > Copy Role ID)
AUTO_ROLE_ID=
# Role allowed to run /phrases (previews every welcome phrase in the current channel)
PREVIEW_ROLE_ID=
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── Mata la jerga ─────────────────────────────────────────────────────────
# Channel where the game lives. Rounds start automatically here at random times.
JERGA_CHANNEL_ID=
# Automatic rounds per day (0 disables them)
JERGA_ROUNDS_PER_DAY=6
# Hours (local time of this machine) in which rounds may start; 0-24 means all day
JERGA_ACTIVE_HOURS=0-24
# Minutes to submit explanations, then minutes to vote
JERGA_SUBMIT_MINUTES=120
JERGA_VOTE_MINUTES=60
# Post a round as soon as the bot logs in (handy for testing)
JERGA_ROUND_ON_START=false
